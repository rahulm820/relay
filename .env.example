# Copy to .env for local development. Never commit .env.
# Secrets are referenced by credentials_ref in the DB (env:NAME locally); raw values live only here.
# Empty value = unset. Names marked (required) must be set or services refuse to start.

NODE_ENV=development
LOG_LEVEL=info

# (required) PostgreSQL 16 + pgvector. Separate database from Switch's own Postgres.
POSTGRES_USER=relay
POSTGRES_PASSWORD=change-me
POSTGRES_DB=relay
# Host port 5433 (container 5432) so Relay coexists with Switch's own Postgres on 5432.
# DATABASE_URL is the app connection (relay_api, subject to RLS). DATABASE_ADMIN_URL is the schema
# owner, used only by db:migrate / db:seed. Role passwords are set by db:migrate from the vars below.
DATABASE_URL=postgres://relay_api:change-me-api@localhost:5433/relay
DATABASE_ADMIN_URL=postgres://relay:change-me@localhost:5433/relay
RELAY_API_DB_PASSWORD=change-me-api
RELAY_WORKER_DB_PASSWORD=change-me-worker

# (required) Redis: queue + idempotency cache
REDIS_URL=redis://localhost:6379

# Service ports (container ports; Compose publishes the worker on host 8091 to avoid Switch's 8081)
API_HOST=0.0.0.0
API_PORT=8080
WORKER_PORT=8081

# Admin web app (apps/web). Server-side only: Next proxies /api/* to this URL, so the browser never sees it
# and the session cookie stays same-origin. Not a NEXT_PUBLIC_ variable.
RELAY_API_URL=http://localhost:8080

# Telegram. The webhook secret is generated per bot by `npm run telegram:register` (only its hash is stored).
# TELEGRAM_BOT_TOKEN is the variable the seeded bot's credentials_ref points at (env:TELEGRAM_BOT_TOKEN).
# TELEGRAM_WEBHOOK_PUBLIC_URL is the https base URL where the API is reachable, e.g. a cloudflared tunnel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_PUBLIC_URL=

# Encrypts raw message text at rest (AES-256-GCM). Required by the API. Generate: openssl rand -base64 32
MESSAGE_ENCRYPTION_KEY=

# Admin API (Issue #17). Browser origins allowed to call it with the session cookie (comma separated, no wildcard).
ADMIN_ALLOWED_ORIGINS=http://localhost:3000
ADMIN_SESSION_TTL_HOURS=12
ADMIN_SESSION_IDLE_MINUTES=60
# Leave empty: Secure cookies are on in production, off otherwise
ADMIN_COOKIE_SECURE=
# First admin, read by `npm run db:seed` ONLY (never by the API). Set them in your shell just for that command:
#   read -p "admin email: " ADMIN_EMAIL; read -s -p "admin password: " ADMIN_PASSWORD; export ADMIN_EMAIL ADMIN_PASSWORD
# Leave blank here; no default password exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# GitHub (least privilege: issues:write + metadata:read)
GITHUB_TOKEN=

# Switch (local gateway; admin login = the GATEWAY_ADMIN_* values from Switch's own .env)
SWITCH_GATEWAY_URL=http://localhost:8000/gateway
SWITCH_ADMIN_EMAIL=
SWITCH_ADMIN_PASSWORD=
AGENT_REGISTRATION_TOKEN=
SWITCH_BRIDGE_ID=

# LLM: provider is gemini | anthropic | ollama. Gemini free tier is the demo default (limits UNVERIFIED).
# Set model IDs from the provider's own docs; they are config, not code.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_BASE_URL=
LLM_FAST_MODEL=
LLM_STRONG_MODEL=
