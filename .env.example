# Copy to .env for local development. Never commit .env.
# Secrets are referenced by credentials_ref in the DB; raw values live only here (local dev).

NODE_ENV=development

# PostgreSQL 16 + pgvector (separate database from Switch's own Postgres)
POSTGRES_USER=relay
POSTGRES_PASSWORD=change-me
POSTGRES_DB=relay
DATABASE_URL=postgres://relay:change-me@localhost:5432/relay

# Redis (queue + idempotency cache)
REDIS_URL=redis://localhost:6379

# Service ports
API_PORT=8080
WORKER_PORT=8081

# Telegram (per-bot tokens are stored by the admin API, not here)
TELEGRAM_WEBHOOK_PUBLIC_URL=

# GitHub (least privilege: issues:write + metadata:read)
GITHUB_TOKEN=

# Switch (agent registration token from Switch secrets)
AGENT_REGISTRATION_TOKEN=

# LLM
ANTHROPIC_API_KEY=
LLM_FAST_MODEL=claude-haiku-5-5
LLM_STRONG_MODEL=claude-sonnet-5-5
