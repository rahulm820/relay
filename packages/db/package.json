{
  "name": "@relay/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "test": "tsx --test src/*.test.ts",
    "db:migrate": "tsx src/cli.ts migrate",
    "db:migrate:down": "tsx src/cli.ts migrate:down",
    "db:seed": "tsx src/cli.ts seed"
  },
  "dependencies": {
    "@relay/shared": "0.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15"
  }
}
