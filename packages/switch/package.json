{
  "name": "@relay/switch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "test": "tsx --test --test-concurrency=1 src/*.test.ts",
    "switch:bootstrap": "tsx src/bootstrap-cli.ts",
    "switch:smoke": "tsx src/smoke-cli.ts"
  },
  "dependencies": {
    "@relay/shared": "0.1.0",
    "@relay/core": "0.1.0",
    "@relay/db": "0.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/mock-switch.d.ts",
      "default": "./dist/testing/mock-switch.js"
    }
  }
}
