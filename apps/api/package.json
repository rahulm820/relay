{
  "name": "@relay/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "clean": "rm -rf dist",
    "test": "tsx --test --test-concurrency=1 src/*.test.ts"
  },
  "dependencies": {
    "@relay/shared": "0.1.0",
    "fastify": "^5.0.0",
    "@relay/channels": "0.1.0",
    "@relay/core": "0.1.0",
    "@relay/db": "0.1.0"
  },
  "devDependencies": {
    "tsx": "^4.0.0"
  }
}
